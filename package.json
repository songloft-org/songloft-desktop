{
  "name": "songloft-desktop",
  "version": "1.3.4",
  "description": "Songloft Desktop — 插件化、无广告的免费音乐播放器（Electron 桌面端）",
  "author": "Edwin <edwinhuish@gmail.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/songloft-org/songloft-desktop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/songloft-org/songloft-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/songloft-org/songloft-desktop/issues"
  },
  "main": "./out/main/index.js",
  "desktopName": "io.github.edwinhuish.songloft-desktop",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "pnpm run typecheck && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test": "vitest run",
    "e2e": "bash scripts/e2e/run.sh",
    "shots": "bash scripts/e2e/shots.sh",
    "lint": "eslint .",
    "audit": "pnpm audit --audit-level=high",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "bash scripts/make-icons.sh",
    "desktop:install": "bash scripts/desktop-integration.sh install",
    "desktop:uninstall": "bash scripts/desktop-integration.sh uninstall",
    "pack:linux": "pnpm run build && electron-builder --linux --publish never",
    "pack:deb": "pnpm run build && electron-builder --linux deb --publish never",
    "pack:appimage": "pnpm run build && electron-builder --linux AppImage --publish never",
    "pack:win": "pnpm run build && electron-builder --win --publish never",
    "pack:mac": "pnpm run build && electron-builder --mac --publish never",
    "verify:package": "bash scripts/verify-package.sh",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test",
    "release": "bumpp"
  },
  "dependencies": {
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "bumpp": "^12.3.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
